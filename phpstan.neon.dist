includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	# Analyse as the oldest PHP the plugin claims to support, so 8.x-only
	# syntax and functions are reported here rather than on a client server.
	phpVersion: 70400
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	paths:
		- brace.php
		- uninstall.php
		- src
	scanFiles:
		- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
		- vendor/php-stubs/wp-cli-stubs/wp-cli-commands-stubs.php
		- vendor/php-stubs/wp-cli-stubs/wp-cli-tools-stubs.php
